# =============================================================
# MongoDB Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Replace ALL placeholder values below with real values.
# 3. Never commit the .env file to version control.
# =============================================================

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=YOUR_ADMIN_USER_HERE
MONGO_INITDB_ROOT_PASSWORD=YOUR_STRONG_PASSWORD_HERE
MONGO_PORT=27017

# --- Mongo Express Web UI Basic Auth (Dev only) ---
# These credentials protect the Mongo Express web interface.
ME_CONFIG_BASICAUTH_USERNAME=YOUR_UI_USER_HERE
ME_CONFIG_BASICAUTH_PASSWORD=YOUR_UI_PASSWORD_HERE
MONGO_EXPRESS_PORT=8081

# =============================================================
# PostgreSQL Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Replace ALL placeholder values below with real values.
# 3. Never commit the .env file to version control.
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=YOUR_DB_USER_HERE
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=YOUR_DATABASE_NAME_HERE
POSTGRES_PORT=5432

# --- pgAdmin (Dev only) ---
PGADMIN_EMAIL=YOUR_EMAIL_HERE
PGADMIN_PASSWORD=YOUR_PGADMIN_PASSWORD_HERE
PGADMIN_PORT=5050

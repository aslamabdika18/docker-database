# =============================================================
# Redis Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Replace ALL placeholder values below with real values.
# 3. Never commit the .env file to version control.
# =============================================================

# --- Redis ---
REDIS_PASSWORD=YOUR_STRONG_PASSWORD_HERE
REDIS_PORT=6379

# Maximum memory Redis is allowed to use.
# Accepts units: kb, mb, gb. Example: 128mb, 512mb, 1gb
# Must be lower than the container memory limit in docker-compose.prod.yaml (256m).
REDIS_MAX_MEMORY=128mb

# --- RedisInsight (Dev only) ---
REDISINSIGHT_PORT=5540
